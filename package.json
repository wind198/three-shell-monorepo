{
  "name": "three-shell-workspace",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter './packages/**' test && pnpm test:cli && pnpm test:assets",
    "dev": "pnpm --filter @three-shell/playground-next dev",
    "clean": "pnpm -r clean",
    "scene:new": "node tools/scene-cli/bin/three-shell-scene.mjs new",
    "scene:sync": "node tools/scene-cli/bin/three-shell-scene.mjs sync",
    "scene:list": "node tools/scene-cli/bin/three-shell-scene.mjs list",
    "test:cli": "node --test tools/scene-cli/tests/*.test.mjs",
    "dev:lighting-room": "pnpm --filter @three-shell/lighting-room dev",
    "test:assets": "node --test tools/asset-discovery/tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
